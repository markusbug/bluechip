# Which network the site talks to: base | baseSepolia | anvil
VITE_CHAIN=base
# Public URL (Open Graph tags, canonical link)
VITE_SITE_URL=https://onbluechip.com
VITE_GITHUB_URL=https://github.com/markusbug/bluechip
# Optional Google Analytics 4 measurement ID; leave unset to send nothing
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# $CHIP address from `bankr launch`. Overrides contracts/deployments/<chainId>.json, so the
# buy section can go live before the fund is deployed.
# VITE_CHIP_ADDRESS=0x...
# Optional RPC for the chosen chain (defaults to the public endpoint)
# VITE_RPC_URL=https://...
